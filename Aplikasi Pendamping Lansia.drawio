  <diagram id="Ye2HX5qRR_HPQog0qzAp" name="Halaman-5">
    <mxGraphModel dx="2738" dy="1127" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Lansia {\n    +String idLansia\n    +String nama\n    +Date tanggalLahir\n    +String alamat\n    +String nomorTelepon\n    +String kondisiKesehatan\n    +perbaruiProfil()\n    +lihatJadwal()\n    +kirimPermintaanBantuan()\n  }\n\n  class Pendamping {\n    +String idPendamping\n    +String nama\n    +String nomorTelepon\n    +String keahlian\n    +boolean tersedia\n    +perbaruiKetersediaan()\n    +terimaTugas()\n    +catatAktivitas()\n  }\n\n  class Keluarga {\n    +String idKeluarga\n    +String nama\n    +String email\n    +String nomorTelepon\n    +pantauKondisiLansia()\n    +terimaNotifikasi()\n    +hubungiPendamping()\n  }\n\n  class Admin {\n    +String idAdmin\n    +String nama\n    +String email\n    +kelolaPengguna()\n    +verifikasiPendamping()\n    +kelolaLayanan()\n    +buatLaporan()\n  }\n\n  class Akun {\n    +String idAkun\n    +String username\n    +String password\n    +String peran\n    +Date waktuLoginTerakhir\n    +login()\n    +logout()\n    +ubahPassword()\n  }\n\n  class ProfilKesehatan {\n    +String idProfil\n    +String golonganDarah\n    +String alergi\n    +String riwayatPenyakit\n    +String obatRutin\n    +perbaruiDataKesehatan()\n  }\n\n  class Jadwal {\n    +String idJadwal\n    +Date tanggal\n    +String waktuMulai\n    +String waktuSelesai\n    +String jenisAktivitas\n    +String status\n    +buatJadwal()\n    +ubahStatus()\n    +batalkan()\n  }\n\n  class AktivitasPendampingan {\n    +String idAktivitas\n    +Date waktu\n    +String jenisAktivitas\n    +String catatan\n    +String lokasi\n    +catatAktivitas()\n    +lihatRiwayat()\n  }\n\n  class PermintaanBantuan {\n    +String idPermintaan\n    +Date waktuPermintaan\n    +String jenisBantuan\n    +String deskripsi\n    +String status\n    +buatPermintaan()\n    +terimaPermintaan()\n    +selesaikanPermintaan()\n    +batalkanPermintaan()\n  }\n\n  class Notifikasi {\n    +String idNotifikasi\n    +String judul\n    +String pesan\n    +Date waktuKirim\n    +boolean sudahDibaca\n    +kirim()\n    +tandaiSudahDibaca()\n  }\n\n  class Pesan {\n    +String idPesan\n    +String isiPesan\n    +Date waktuKirim\n    +boolean sudahDibaca\n    +kirimPesan()\n    +bacaPesan()\n  }\n\n  class Obat {\n    +String idObat\n    +String namaObat\n    +String dosis\n    +String aturanMinum\n    +String waktuMinum\n    +tandaiSudahDiminum()\n  }\n\n  class Laporan {\n    +String idLaporan\n    +Date periodeMulai\n    +Date periodeSelesai\n    +String jenisLaporan\n    +String isiLaporan\n    +buatLaporan()\n    +eksporLaporan()\n  }\n\n  Lansia \&quot;1\&quot; *-- \&quot;1\&quot; Akun : memiliki\n  Pendamping \&quot;1\&quot; *-- \&quot;1\&quot; Akun : memiliki\n  Keluarga \&quot;1\&quot; *-- \&quot;1\&quot; Akun : memiliki\n  Admin \&quot;1\&quot; *-- \&quot;1\&quot; Akun : memiliki\n\n  Lansia \&quot;1\&quot; *-- \&quot;1\&quot; ProfilKesehatan : memiliki\n  ProfilKesehatan \&quot;1\&quot; o-- \&quot;*\&quot; Obat : menggunakan\n\n  Lansia \&quot;1\&quot; --&gt; \&quot;*\&quot; Jadwal : memiliki\n  Pendamping \&quot;1\&quot; --&gt; \&quot;*\&quot; Jadwal : menjalankan\n  Jadwal \&quot;1\&quot; *-- \&quot;*\&quot; AktivitasPendampingan : mencakup\n\n  Lansia \&quot;1\&quot; --&gt; \&quot;*\&quot; PermintaanBantuan : membuat\n  Pendamping \&quot;0..1\&quot; --&gt; \&quot;*\&quot; PermintaanBantuan : menangani\n\n  Lansia \&quot;1\&quot; --&gt; \&quot;*\&quot; Notifikasi : menerima\n  Pendamping \&quot;1\&quot; --&gt; \&quot;*\&quot; Notifikasi : menerima\n  Keluarga \&quot;1\&quot; --&gt; \&quot;*\&quot; Notifikasi : menerima\n\n  Lansia \&quot;1\&quot; --&gt; \&quot;*\&quot; Pesan : mengirim\n  Pendamping \&quot;1\&quot; --&gt; \&quot;*\&quot; Pesan : mengirim\n  Keluarga \&quot;1\&quot; --&gt; \&quot;*\&quot; Pesan : mengirim\n\n  Keluarga \&quot;1\&quot; --&gt; \&quot;*\&quot; Lansia : memantau\n  Keluarga \&quot;1\&quot; --&gt; \&quot;*\&quot; Laporan : menerima\n  Admin \&quot;1\&quot; --&gt; \&quot;*\&quot; Laporan : menghasilkan\n  Admin \&quot;1\&quot; --&gt; \&quot;*\&quot; Pendamping : memverifikasi\n  Admin \&quot;1\&quot; --&gt; \&quot;*\&quot; Akun : mengelola&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1VxhNFWpheWlHRZzCKVL-1">
