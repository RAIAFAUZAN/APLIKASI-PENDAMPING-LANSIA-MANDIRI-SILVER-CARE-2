        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    LANSIA ||--o{ PROFIL_KESEHATAN : memiliki\n    LANSIA ||--o{ JADWAL_PERAWATAN : memiliki\n    LANSIA ||--o{ PENGINGAT_OBAT : memiliki\n    OBAT ||--o{ PENGINGAT_OBAT : digunakan_dalam\n    LANSIA ||--o{ CATATAN_KEGIATAN : melakukan\n    LANSIA ||--o{ PEMANTAUAN_KESEHATAN : dipantau\n    PENDAMPING ||--o{ JADWAL_PERAWATAN : mengatur\n    PENDAMPING ||--o{ CATATAN_KEGIATAN : mencatat\n    PENDAMPING ||--o{ PEMANTAUAN_KESEHATAN : memantau\n    LANSIA ||--o{ KONTAK_DARURAT : memiliki\n    PENDAMPING ||--o{ NOTIFIKASI : menerima\n    LANSIA ||--o{ NOTIFIKASI : terkait\n\n    LANSIA {\n        int id_lansia PK\n        string nama_lengkap\n        date tanggal_lahir\n        string jenis_kelamin\n        string alamat\n        string nomor_telepon\n        string golongan_darah\n        string status\n    }\n\n    PENDAMPING {\n        int id_pendamping PK\n        string nama_lengkap\n        string email UK\n        string kata_sandi\n        string nomor_telepon\n        string hubungan\n        string status\n    }\n\n    PROFIL_KESEHATAN {\n        int id_profil PK\n        int id_lansia FK\n        string riwayat_penyakit\n        string alergi\n        string kondisi_fisik\n        string catatan_dokter\n        date tanggal_pembaruan\n    }\n\n    OBAT {\n        int id_obat PK\n        string nama_obat\n        string jenis_obat\n        string dosis\n        string satuan\n        string deskripsi\n    }\n\n    PENGINGAT_OBAT {\n        int id_pengingat PK\n        int id_lansia FK\n        int id_obat FK\n        time waktu_minum\n        string frekuensi\n        date tanggal_mulai\n        date tanggal_selesai\n        string status\n    }\n\n    JADWAL_PERAWATAN {\n        int id_jadwal PK\n        int id_lansia FK\n        int id_pendamping FK\n        string jenis_kegiatan\n        date tanggal\n        time waktu_mulai\n        time waktu_selesai\n        string lokasi\n        string status\n        string catatan\n    }\n\n    CATATAN_KEGIATAN {\n        int id_catatan PK\n        int id_lansia FK\n        int id_pendamping FK\n        string jenis_kegiatan\n        datetime waktu_kegiatan\n        string deskripsi\n        string kondisi_lansia\n    }\n\n    PEMANTAUAN_KESEHATAN {\n        int id_pemantauan PK\n        int id_lansia FK\n        int id_pendamping FK\n        datetime waktu_pemantauan\n        decimal tekanan_darah\n        int detak_jantung\n        decimal suhu_tubuh\n        decimal berat_badan\n        string keluhan\n        string catatan\n    }\n\n    KONTAK_DARURAT {\n        int id_kontak PK\n        int id_lansia FK\n        string nama_kontak\n        string hubungan\n        string nomor_telepon\n        string prioritas\n    }\n\n    NOTIFIKASI {\n        int id_notifikasi PK\n        int id_lansia FK\n        int id_pendamping FK\n        string jenis_notifikasi\n        string judul\n        string isi\n        datetime waktu_kirim\n        boolean sudah_dibaca\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_5J9DpudWgiA8zsHvusz-2">
